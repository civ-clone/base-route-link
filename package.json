{
  "name": "@civ-clone/base-route-link",
  "version": "0.0.0",
  "description": "Whether two squares are joined by an unbroken chain of road or railroad squares, and a city's link to its capital, cached per player.",
  "repository": "git@github.com:civ-clone/base-route-link.git",
  "keywords": [
    "typescript",
    "civilization"
  ],
  "author": "dom111 <dom111@users.noreply.github.com>",
  "license": "MIT",
  "private": false,
  "files": [
    "lib/**/*.ts",
    "lib/**/*.js",
    "lib/**/*.js.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "bench": "ts-mocha ./bench/*.ts",
    "build": "npm run ts:compile && npm run prettier:format",
    "prettier:check": "prettier --config .prettierrc --check '**/*.ts'",
    "prettier:format": "prettier --config .prettierrc '**/*.ts' --write",
    "test": "ts-mocha ./tests/*.test.ts",
    "ts:compile": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@civ-clone/core-terrain": "^0.1.4",
    "@civ-clone/core-world-generator": "^0.1.7",
    "@types/chai": "^4.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^16.0.0",
    "chai": "^4.0.0",
    "mocha": "^10.0.0",
    "prettier": "^2.8.8",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.0.0"
  },
  "dependencies": {
    "@civ-clone/core-city": "^0.1.25",
    "@civ-clone/core-player": "^0.1.10",
    "@civ-clone/core-rule": "^0.1.9",
    "@civ-clone/core-tile-improvement": "^0.1.6",
    "@civ-clone/core-world": "^0.1.24"
  }
}
